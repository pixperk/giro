# copy to .env and adjust. .env is gitignored.

# the serving connection. this should be a role with no privileges of its own
# that is a member of giro_app: select, insert, and update on named columns,
# and nothing else. it cannot disable the database guards, drop a table or
# erase history.
#
# run "just db-app-role" to create one locally, then point this at it:
#   postgres://giro_service@localhost:5432/giro
#
# "just privileges" prints what this connection can actually do. "giro serve"
# warns at boot if it can switch off the guards protecting it.
DATABASE_URL=postgres://USER@localhost:5432/giro

# migrations need the role that owns the tables, which is deliberately not the
# one above. keep it out of the serving environment.
GIRO_MIGRATE_DATABASE_URL=postgres://USER@localhost:5432/giro

GIRO_TEST_DATABASE_URL=postgres://USER@localhost:5432/giro_test
